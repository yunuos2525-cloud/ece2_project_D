# W2 COMBO II-DLD S75 / xc7s75fgga484-1. Base mappings are preserved from
# W1. LCD and UI mappings are from the local LAB3 Character LCD and LAB2
# integrated board projects; no package pin is shared.
set_property PACKAGE_PIN B6 [get_ports clk_50mhz]
set_property PACKAGE_PIN K4 [get_ports rst_p]
set_property PACKAGE_PIN U4 [get_ports {adc_channel[0]}]
set_property PACKAGE_PIN V4 [get_ports {adc_channel[1]}]
set_property PACKAGE_PIN W1 [get_ports {adc_channel[2]}]
set_property PACKAGE_PIN H3 [get_ports adc_ncs]
set_property PACKAGE_PIN H5 [get_ports adc_din]
set_property PACKAGE_PIN J6 [get_ports adc_dout]
set_property PACKAGE_PIN H7 [get_ports adc_sclk]
set_property PACKAGE_PIN G2 [get_ports dac_a_b]
set_property PACKAGE_PIN E1 [get_ports dac_csn]
set_property PACKAGE_PIN F4 [get_ports dac_ldacn]
set_property PACKAGE_PIN G4 [get_ports dac_wen]
set_property PACKAGE_PIN E3 [get_ports {dac_d[0]}]
set_property PACKAGE_PIN E5 [get_ports {dac_d[1]}]
set_property PACKAGE_PIN D2 [get_ports {dac_d[2]}]
set_property PACKAGE_PIN D5 [get_ports {dac_d[3]}]
set_property PACKAGE_PIN C2 [get_ports {dac_d[4]}]
set_property PACKAGE_PIN C4 [get_ports {dac_d[5]}]
set_property PACKAGE_PIN B1 [get_ports {dac_d[6]}]
set_property PACKAGE_PIN B3 [get_ports {dac_d[7]}]
set_property PACKAGE_PIN F8 [get_ports spi_sck]
set_property PACKAGE_PIN E8 [get_ports spi_mosi]
set_property PACKAGE_PIN A7 [get_ports spi_cs_n]
set_property PACKAGE_PIN G8 [get_ports spi_miso]
set_property PACKAGE_PIN N5 [get_ports {led_out[0]}]
set_property PACKAGE_PIN M1 [get_ports {led_out[1]}]
set_property PACKAGE_PIN M3 [get_ports {led_out[2]}]
set_property PACKAGE_PIN M7 [get_ports {led_out[3]}]
set_property PACKAGE_PIN N7 [get_ports {led_out[4]}]
set_property PACKAGE_PIN M2 [get_ports {led_out[5]}]
set_property PACKAGE_PIN M4 [get_ports {led_out[6]}]
set_property PACKAGE_PIN L4 [get_ports {led_out[7]}]

set_property PACKAGE_PIN W4 [get_ports {display_mode[0]}]
set_property PACKAGE_PIN T1 [get_ports {display_mode[1]}]
set_property PACKAGE_PIN N8 [get_ports sw_start_btn]
set_property PACKAGE_PIN N4 [get_ports sw_stop_btn]
set_property PACKAGE_PIN Y1 [get_ports sw_reset_switch]
set_property PACKAGE_PIN A6 [get_ports lcd_e]
set_property PACKAGE_PIN G6 [get_ports lcd_rs]
set_property PACKAGE_PIN D6 [get_ports lcd_rw]
set_property PACKAGE_PIN A4 [get_ports {lcd_data[0]}]
set_property PACKAGE_PIN B2 [get_ports {lcd_data[1]}]
set_property PACKAGE_PIN C3 [get_ports {lcd_data[2]}]
set_property PACKAGE_PIN D4 [get_ports {lcd_data[3]}]
set_property PACKAGE_PIN A2 [get_ports {lcd_data[4]}]
set_property PACKAGE_PIN C5 [get_ports {lcd_data[5]}]
set_property PACKAGE_PIN C1 [get_ports {lcd_data[6]}]
set_property PACKAGE_PIN D1 [get_ports {lcd_data[7]}]

set_property IOSTANDARD LVCMOS33 [get_ports *]
create_clock -name clk_50mhz -period 20.000 [get_ports clk_50mhz]
set_false_path -from [get_ports rst_p] -to [get_cells -hier -regexp {.*u_reset_conditioner/sync_ff_reg\[[0-9]+\]}]
set_false_path -from [get_ports spi_sck] -to [get_cells -hier -regexp {.*u_spi/sck_sync_reg\[0\]}]
set_false_path -from [get_ports spi_mosi] -to [get_cells -hier -regexp {.*u_spi/mosi_sync_reg\[0\]}]
set_false_path -from [get_ports spi_cs_n] -to [get_cells -hier -regexp {.*u_spi/cs_sync_reg\[0\]}]
set_false_path -from [get_ports {sw_start_btn sw_stop_btn sw_reset_switch display_mode[*]}] -to \
    [get_cells -hier -regexp {.*u_(start|stop|sw_reset|display0|display1)/sync_ff_reg\[0\]}]
set_false_path -from [get_ports {adc_channel[*] adc_dout}]

# Physical J10/BD_SEL1 MISO route, N8/N4 button polarity, LCD module presence,
# voltage and contention remain mandatory POST board checks.
