set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(STM32_BOARD "NUCLEO_G474RE" CACHE STRING "Target Nucleo board")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES STM32_BOARD)
if(DEFINED STM32_CONFIGURED_BOARD AND NOT STM32_CONFIGURED_BOARD STREQUAL STM32_BOARD)
    message(FATAL_ERROR "Use a separate build directory for each STM32_BOARD")
endif()
set(STM32_CONFIGURED_BOARD "${STM32_BOARD}" CACHE INTERNAL "Board used to initialize CPU flags")

find_program(CMAKE_C_COMPILER arm-none-eabi-gcc REQUIRED)
set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
if(STM32_BOARD STREQUAL "NUCLEO_G474RE")
    set(cpu_flags "-mcpu=cortex-m4 -mthumb -mfpu=fpv4-sp-d16 -mfloat-abi=hard")
elseif(STM32_BOARD STREQUAL "NUCLEO_H533RE")
    set(cpu_flags "-mcpu=cortex-m33 -mthumb -mfpu=fpv5-sp-d16 -mfloat-abi=hard")
else()
    message(FATAL_ERROR "Unsupported STM32_BOARD: ${STM32_BOARD}")
endif()
set(CMAKE_C_FLAGS_INIT "${cpu_flags}")
set(CMAKE_ASM_FLAGS_INIT "${cpu_flags}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${cpu_flags}")
